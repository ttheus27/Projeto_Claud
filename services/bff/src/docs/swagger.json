{
  "openapi": "3.0.0",
  "info": {
    "title": "BFF (Backend for Frontend) — Integrador Schulz S/A",
    "description": "BFF que consulta os dois microserviços e chama a Azure Function para calcular custos. Entrada pública centralizada no API Gateway.",
    "version": "1.0.0",
    "contact": {
      "name": "Equipe Schulz / SKA (Alexandre Filho, Ana Julia, Felipe Nathan, Matheus Silva)"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "API Gateway autenticado"
    }
  ],
  "paths": {
    "/api/events": {
      "get": {
        "summary": "Consome os eventos recentes de negócio publicados pelo BFF",
        "description": "Retorna até 100 eventos em memória. O painel consulta este endpoint periodicamente para apresentar eventos recebidos em tempo real.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos publicados recentemente."
          }
        }
      }
    },
    "/api/aggregated-data": {
      "get": {
        "summary": "ENDPOINT MANDATÓRIO PJBL: Retorna dados agregados de Orçamento (Mongo) + Pedidos (SQL) + Azure Function",
        "description": "Consulta Mongo e SQL em paralelo, envia os dados consolidados à Azure Function e retorna um único JSON. Falhas parciais são identificadas na resposta.",
        "responses": {
          "200": {
            "description": "Dados agregados retornados com sucesso."
          },
          "500": {
            "description": "Falha na agregação."
          }
        }
      }
    },
    "/api/orcamentos": {
      "get": {
        "summary": "Proxy: Consulta todos os orçamentos no Microserviço 1 (MongoDB)",
        "responses": {
          "200": {
            "description": "Lista de orçamentos."
          }
        }
      },
      "post": {
        "summary": "Proxy: Cria novo orçamento no Microserviço 1 (MongoDB)",
        "responses": {
          "201": {
            "description": "Criado com sucesso."
          }
        }
      }
    },
    "/api/pedidos": {
      "get": {
        "summary": "Proxy: Consulta todas as ordens de produção no Microserviço 2 (Azure SQL)",
        "responses": {
          "200": {
            "description": "Lista de pedidos."
          }
        }
      },
      "post": {
        "summary": "Proxy: Registra nova ordem de produção no Microserviço 2 (Azure SQL)",
        "responses": {
          "201": {
            "description": "Registrado com sucesso."
          }
        }
      }
    },
    "/api/pedidos/gerar-de-orcamento": {
      "post": {
        "summary": "Ação Comercial: Gera automaticamente um Pedido no banco SQL a partir de um Orçamento aprovado",
        "responses": {
          "201": {
            "description": "Ordem gerada na TB_PEDIDOS."
          }
        }
      }
    },
    "/api/orcamentos/{id}": {
      "get": {
        "summary": "GET de orcamentos pelo microserviço",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "404": {
            "description": "Registro não encontrado"
          }
        }
      },
      "put": {
        "summary": "PUT de orcamentos pelo microserviço",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "404": {
            "description": "Registro não encontrado"
          }
        }
      },
      "delete": {
        "summary": "DELETE de orcamentos pelo microserviço",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "404": {
            "description": "Registro não encontrado"
          }
        }
      }
    },
    "/api/pedidos/{id}": {
      "get": {
        "summary": "GET de pedidos pelo microserviço",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "404": {
            "description": "Registro não encontrado"
          }
        }
      },
      "put": {
        "summary": "PUT de pedidos pelo microserviço",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "404": {
            "description": "Registro não encontrado"
          }
        }
      },
      "delete": {
        "summary": "DELETE de pedidos pelo microserviço",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "404": {
            "description": "Registro não encontrado"
          }
        }
      }
    }
  }
}
