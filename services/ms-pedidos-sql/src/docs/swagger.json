{
  "openapi": "3.0.0",
  "info": {
    "title": "Microserviço 2 — Gestão de Pedidos e Ordens de Produção (Azure SQL)",
    "description": "API REST de Pedidos Industriais vinculados à folha de orçamentos da Schulz S/A (Tabela TB_PEDIDOS).",
    "version": "1.0.0",
    "contact": {
      "name": "Equipe Schulz / SKA (Alexandre Filho, Ana Julia, Felipe Nathan, Matheus Silva)"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "API Gateway autenticado"
    }
  ],
  "paths": {
    "/api/pedidos": {
      "get": {
        "summary": "Lista todos os pedidos industriais (TB_PEDIDOS)",
        "responses": {
          "200": {
            "description": "Lista de pedidos retornada com sucesso."
          }
        }
      },
      "post": {
        "summary": "Registra um novo pedido de compra gerado a partir de um orçamento",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido registrado com sucesso na TB_PEDIDOS."
          },
          "400": {
            "description": "Dados inválidos."
          }
        }
      }
    },
    "/api/pedidos/{id}": {
      "get": {
        "summary": "Obtém dados de um pedido pelo ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido localizado."
          },
          "404": {
            "description": "Pedido não encontrado."
          }
        }
      },
      "put": {
        "summary": "Atualiza o status de produção ou dados do pedido",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido atualizado."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "404": {
            "description": "Pedido não encontrado."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "codigo_orcamento": {
                    "type": "string",
                    "example": "ORC-2026-0891"
                  },
                  "cliente": {
                    "type": "string",
                    "example": "Schulz Compressores S/A"
                  },
                  "descricao_peca": {
                    "type": "string",
                    "example": "Virabrequim Monobloco 2 Cilindros"
                  },
                  "lote_producao": {
                    "type": "integer",
                    "example": 500,
                    "minimum": 1
                  },
                  "valor_total": {
                    "type": "number",
                    "example": 147850.0,
                    "minimum": 0
                  },
                  "status_producao": {
                    "type": "string",
                    "example": "Em Planejamento",
                    "enum": [
                      "Em Planejamento",
                      "Em Usinagem CNC",
                      "Aguardando Expedição",
                      "Concluído"
                    ]
                  },
                  "data_entrega_prevista": {
                    "type": "string",
                    "example": "2026-12-15",
                    "format": "date"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Cancela/remove um pedido",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido removido com sucesso."
          }
        }
      }
    },
    "/api/pedidos/orcamento/{codigoOrcamento}": {
      "get": {
        "summary": "Lista todos os pedidos associados a um código de orçamento",
        "parameters": [
          {
            "name": "codigoOrcamento",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedidos vinculados localizados."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PedidoInput": {
        "type": "object",
        "required": [
          "codigo_orcamento",
          "cliente",
          "descricao_peca",
          "lote_producao",
          "valor_total",
          "data_entrega_prevista"
        ],
        "properties": {
          "codigo_orcamento": {
            "type": "string",
            "example": "ORC-2026-0891"
          },
          "cliente": {
            "type": "string",
            "example": "Schulz Compressores S/A"
          },
          "descricao_peca": {
            "type": "string",
            "example": "Virabrequim Monobloco 2 Cilindros"
          },
          "lote_producao": {
            "type": "integer",
            "example": 500,
            "minimum": 1
          },
          "valor_total": {
            "type": "number",
            "example": 147850.0,
            "minimum": 0
          },
          "status_producao": {
            "type": "string",
            "example": "Em Planejamento",
            "enum": [
              "Em Planejamento",
              "Em Usinagem CNC",
              "Aguardando Expedição",
              "Concluído"
            ]
          },
          "data_entrega_prevista": {
            "type": "string",
            "example": "2026-12-15",
            "format": "date"
          }
        }
      }
    }
  }
}
