# Copie para .env.development.local para usar os microserviços locais pelo BFF.
# Este arquivo só configura o frontend; não inclua credenciais de banco aqui.
VITE_AZURE_GET_ORCAMENTOS_URL=http://localhost:8080/api/orcamentos
VITE_AZURE_CREATE_ORCAMENTO_URL=http://localhost:8080/api/orcamentos
VITE_AZURE_UPDATE_ORCAMENTO_URL=http://localhost:8080/api/orcamentos/{id}
VITE_AZURE_DELETE_ORCAMENTO_URL=http://localhost:8080/api/orcamentos/{id}
VITE_AZURE_FUNCTION_KEY=
VITE_PEDIDOS_URL=http://localhost:8080/api/pedidos
VITE_BFF_AGGREGATED_URL=http://localhost:8080/api/aggregated-data
